#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

for cargo_config in .cargo/config .cargo/config.toml .cargo/audit.toml; do
  if [[ -e "$cargo_config" || -L "$cargo_config" ]]; then
    echo "repository-local Cargo configuration is not permitted: $cargo_config" >&2
    exit 1
  fi
done

git_state_before=""
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git_state_before=$(git status --porcelain=v1 --untracked-files=all)
fi

python3 -m py_compile scripts/guardrails.py scripts/generate-unicode32-bidi.py
scripts/guardrails.py
python3 scripts/generate-unicode32-bidi.py --check
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features --locked --offline -- -D warnings
cargo clippy --workspace --all-targets --no-default-features --features sha256 --locked --offline -- -D warnings
cargo clippy --workspace --all-targets --no-default-features --features sha512 --locked --offline -- -D warnings
cargo test --workspace --locked --offline
cargo test --workspace --all-features --locked --offline
cargo test --workspace --no-default-features --locked --offline
cargo test --workspace --no-default-features --features sha256 --locked --offline
cargo test --workspace --no-default-features --features sha512 --locked --offline
scripts/examples-check
scripts/fuzz-check
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps --locked --offline
cargo deny check bans licenses sources
scripts/package-check
zrail check

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git diff --check
  git diff --cached --check
  git_state_after=$(git status --porcelain=v1 --untracked-files=all)
  if [[ "$git_state_before" != "$git_state_after" ]]; then
    echo "scripts/check changed Git status" >&2
    git status --short --untracked-files=all >&2
    exit 1
  fi
fi
